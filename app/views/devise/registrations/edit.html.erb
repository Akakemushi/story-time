<h2>Edit <%= resource_name.to_s.humanize %></h2>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <div class="text-center mb-3">
      <% if resource.avatar.attached? %>
        <%= cl_image_tag(resource.avatar.key, width: 120, height: 120, crop: :fill, gravity: :face, class: "rounded-circle") %>
      <% else %>
        <span class="avatar-placeholder avatar-placeholder-lg"><%= resource.username.first.upcase %></span>
      <% end %>
    </div>
    <%= f.input :avatar, as: :file, label: "Profile photo",
                hint: "JPEG, PNG, GIF, or WebP. Max 5MB.",
                input_html: { accept: "image/jpeg,image/png,image/gif,image/webp" } %>
    <%= f.input :first_name, required: true %>
    <%= f.input :last_name, required: true %>
    <%= f.input :middle_name, required: false %>
    <%= f.input :username, required: true,
                hint: "Max 25 characters. Letters, numbers, underscores, and hyphens only." %>
    <%= f.input :email, required: true %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
    <% end %>

    <%= f.input :password,
                hint: "leave it blank if you don't want to change it",
                required: false,
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :password_confirmation,
                required: false,
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :current_password,
                hint: "we need your current password to confirm your changes",
                required: true,
                input_html: { autocomplete: "current-password" } %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Update" %>
  </div>
<% end %>

<h3>Cancel my account</h3>

<div>Unhappy? <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %></div>

<%= link_to "Back", :back %>
