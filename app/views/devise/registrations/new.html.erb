<h2>Sign up</h2>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "signup-form" }) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <div class="form-row">
      <%= f.input :last_name,
                  required: true,
                  autofocus: true,
                  input_html: { autocomplete: "family-name" } %>
      <%= f.input :first_name,
                  required: true,
                  input_html: { autocomplete: "given-name" } %>
      <%= f.input :middle_name,
                  label: "Middle name(s)",
                  required: false,
                  input_html: { autocomplete: "additional-name" } %>
    </div>
    <div class="form-row">
      <%= f.input :username,
                  required: true,
                  input_html: { autocomplete: "username", placeholder: "Alphanumeric only, max 25 chars" } %>
      <%= f.input :email,
                  required: true,
                  input_html: { autocomplete: "email" } %>
    </div>
    <div class="form-row">
      <%= f.input :password,
                  required: true,
                  input_html: { autocomplete: "new-password", placeholder: "#{@minimum_password_length} characters minimum" } %>
      <%= f.input :password_confirmation,
                  required: true,
                  input_html: { autocomplete: "new-password" } %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Sign up" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
