<div class="navbar navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid">
    <%= link_to '/', class: "navbar-brand d-flex align-items-center light-color" do %>
      <%= image_tag "logo-color.png"%>
      <h2 class="mx-3 my-0">Story Time</h2>
    <% end %>
    <% if user_signed_in? %>
      <div class="d-flex align-items-center order-sm-last">
        <span class="navbar-link me-2">Welcome, <%= current_user.username %>!</span>
        <div class="nav-item dropdown">
          <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <% if current_user.avatar.attached? %>
              <%= cl_image_tag(current_user.avatar.key, width: 40, height: 40, crop: :fill, gravity: :face, class: "avatar", alt: "dropdown menu") %>
            <% else %>
              <span class="avatar-placeholder avatar"><%= current_user.username.first.upcase %></span>
            <% end %>
          </a>
          <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
            <%= link_to "Edit Profile", edit_user_registration_path, class: "dropdown-item" %>
            <%= link_to "Log out", destroy_user_session_path, data: {turbo_method: :delete}, class: "dropdown-item" %>
          </div>
        </div>
      </div>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <li class="nav-item active">
            <%= link_to "Main Page", main_path, class: "nav-link navbar-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "New Story", new_story_path, class: "nav-link navbar-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Library", stories_path, class: "nav-link navbar-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Flashcards", flashcards_path, class: "nav-link navbar-link" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
